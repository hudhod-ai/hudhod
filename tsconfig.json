{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@hudhod/sdk": ["./packages/sdk/src/index.ts"],
      "@hudhod/core": ["./packages/core/src/index.ts"],
      "@hudhod/core/*": ["./packages/core/src/*"],
      "@hudhod/react": ["./packages/react/src/index.tsx"],
      "@hudhod/webcontainer": ["./packages/webcontainer/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "examples/**/*.ts", "examples/**/*.tsx"],
  "exclude": ["node_modules"]
}
