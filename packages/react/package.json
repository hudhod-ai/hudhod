{
  "name": "@hudhod/react",
  "version": "0.2.0",
  "description": "React bindings for hudhod extensions — mount React components into contributed panels.",
  "keywords": [
    "browser-ide",
    "extensions",
    "hudhod",
    "ide",
    "react"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hudhod/core": "workspace:*",
    "@hudhod/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dockview-react": "^8.2.0",
    "lucide-react": "^1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "dockview-react": "^8.2.0",
    "lucide-react": "^1.34.0",
    "react": "^19",
    "react-dom": "^19"
  }
}
