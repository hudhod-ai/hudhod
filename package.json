{
  "name": "hudhod",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm packages:build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "pnpm --filter \"./packages/*\" run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "packages:build": "pnpm --filter \"./packages/*\" run build",
    "examples:build": "pnpm --filter \"./examples/extensions/*\" run build",
    "version-packages": "changeset version",
    "release": "pnpm packages:build && changeset publish",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^3.2.4",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsdown": "^0.15.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.23.0"
}
