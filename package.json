{
  "name": "hudhod",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "packages:build": "pnpm --filter \"./packages/*\" run build",
    "changeset": "changeset",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:db:push": "supabase db push",
    "supabase:migration:new": "supabase migration new",
    "supabase:types": "supabase gen types typescript --linked",
    "bootstrap:build": "docker build -t osamanj93/hudhod-bootstrap:dev ./docker/bootstrap",
    "bootstrap:publish": "docker buildx build --platform linux/amd64,linux/arm64 -t osamanj93/hudhod-bootstrap:latest --push ./docker/bootstrap"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@base-ui/react": "^1.7.0",
    "@hudhod/core": "workspace:*",
    "@hudhod/extension-new-file": "workspace:*",
    "@hudhod/extension-outline": "workspace:*",
    "@hudhod/react": "workspace:*",
    "@hudhod/sdk": "workspace:*",
    "@hudhod/webcontainer": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@scalar/nextjs-api-reference": "^0.11.16",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@webcontainer/api": "^1.6.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockview-react": "^8.2.0",
    "lucide-react": "^1.34.0",
    "monaco-editor": "^0.56.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tar-stream": "^3.2.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "tsdown": "^0.15.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.23.0"
}
