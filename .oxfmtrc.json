{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",

  "printWidth": 100,
  "endOfLine": "lf",

  "sortImports": {
    "internalPattern": ["@hudhod/"],
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "newlinesBetween": true
  },

  "ignorePatterns": [
    "out/**",
    "build/**",
    "pnpm-lock.yaml",
    "packages/*/dist/**",
    "examples/extensions/*/dist/**"
  ]
}
